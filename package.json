{
  "name": "mcemotihari",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@shopify/flash-list": "2.0.2",
    "expo": "~54.0.3",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.22",
    "expo-font": "*",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.23",
    "expo-screen-capture": "~8.0.9",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "firebase": "^10.14.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "^13.15.0",
    "react-native-worklets": "0.5.1",
    "tslib": "^2.8.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "^5.3.3"
  },
  "scripts": {
    "start": "expo start -c",
    "dev": "expo start -c",
    "tunnel": "expo start --tunnel -c",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start -c --web",
    "lint": "expo lint",
    "deploy-web": "npx expo export --platform web && rm -rf functions/dist && cp -r dist functions/dist && (cd functions && [ -d node_modules ] || npm install) && npx -y firebase-tools@latest deploy --force",
    "postinstall": "node -e \"const fs = require('fs'); const p = './node_modules/tslib/tslib.js'; if (fs.existsSync(p)) { const c = fs.readFileSync(p, 'utf8'); if (!c.includes('module.exports.default')) { fs.appendFileSync(p, '\\nmodule.exports.default = module.exports;\\n'); console.log('tslib patched successfully'); } }\"",
    "deploy": "npm run deploy-web"
  },
  "private": true
}
