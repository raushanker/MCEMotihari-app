{
  "expo": {
    "name": "MCEMotihari",
    "slug": "MCEMotihari",
    "version": "2.0.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mcemotihari",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "mcemotihari.app"
    },
    "android": {
      "versionCode": 27,
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "package": "mcemotihari.app",
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "mcemotihari-app.web.app",
              "pathPrefix": "/@"
            },
            {
              "scheme": "https",
              "host": "mcemotihari-app.web.app",
              "pathPrefix": "/post"
            },
            {
              "scheme": "https",
              "host": "mcemotihari-app.web.app",
              "pathPrefix": "/event"
            },
            {
              "scheme": "https",
              "host": "mcemotihari-app.web.app",
              "pathPrefix": "/notice"
            },
            {
              "scheme": "https",
              "host": "mcemotihari-app.web.app",
              "pathPrefix": "/study"
            },
            {
              "scheme": "https",
              "host": "mcemotihari-app.firebaseapp.com",
              "pathPrefix": "/@"
            },
            {
              "scheme": "https",
              "host": "mcemotihari-app.firebaseapp.com",
              "pathPrefix": "/post"
            },
            {
              "scheme": "https",
              "host": "mcemotihari-app.firebaseapp.com",
              "pathPrefix": "/event"
            },
            {
              "scheme": "https",
              "host": "mcemotihari-app.firebaseapp.com",
              "pathPrefix": "/notice"
            },
            {
              "scheme": "https",
              "host": "mcemotihari-app.firebaseapp.com",
              "pathPrefix": "/study"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#0F172A",
            "image": "./assets/images/icon.png"
          }
        }
      ],
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1071649927142-t81ph2rfvf8aef5lf3hh753hf0cp2jst"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow MCE Connect to access your photos for profile pictures and posts.",
          "cameraPermission": "Allow MCE Connect to access your camera for taking photos."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "73b46297-5992-4e19-959b-770ba2b93f18"
      }
    }
  }
}
