rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Simple admin check: either the specific uid or matching adminRole in Firestore (if possible, though Storage rules don't easily read Firestore unless using Firestore in Storage, which is in beta. For now, rely on UID or just let anyone read approved materials).
    function isAdmin() {
      return isAuthenticated() && request.auth.uid == 'Zdxi8kTc2kcs1cOPxWS81PTVmco2';
    }

    match /study_materials/{allPaths=**} {
      // Anyone can read public study materials
      allow read: if true;
      
      // Restrict size to ~25MB and validate MIME type to prevent malicious uploads
      allow create: if isAuthenticated() && 
                    request.resource.size < 26214400 && 
                    request.resource.contentType.matches('application/pdf|image/.*|application/vnd.openxmlformats-officedocument.*|application/msword');
      
      // Only owner or admin can update (overwrite) existing files
      allow update: if isAuthenticated() && 
                    request.resource.size < 26214400 &&
                    request.resource.contentType.matches('application/pdf|image/.*|application/vnd.openxmlformats-officedocument.*|application/msword') &&
                    (isAdmin() || request.auth.uid == resource.metadata.ownerUid);
      
      // Only owner or admin can delete
      allow delete: if isAdmin() || (isAuthenticated() && request.auth.uid == resource.metadata.ownerUid);
    }
    
    match /pending_materials/{allPaths=**} {
      allow read: if isAuthenticated() && (isAdmin() || request.auth.uid == resource.metadata.ownerUid);
      
      allow create: if isAuthenticated() && 
                    request.resource.size < 26214400 && 
                    request.resource.contentType.matches('application/pdf|image/.*|application/vnd.openxmlformats-officedocument.*|application/msword');
      
      allow update: if isAuthenticated() && 
                    request.resource.size < 26214400 &&
                    request.resource.contentType.matches('application/pdf|image/.*|application/vnd.openxmlformats-officedocument.*|application/msword') &&
                    (isAdmin() || request.auth.uid == resource.metadata.ownerUid);
                    
      allow delete: if isAdmin() || (isAuthenticated() && request.auth.uid == resource.metadata.ownerUid);
    }
    
    // Default deny for everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
