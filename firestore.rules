rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.uid == 'Zdxi8kTc2kcs1cOPxWS81PTVmco2' ||
        request.auth.uid == 'DdP2c855PSRUJwhmN9rvbkYBraP2' ||
        (exists(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)) &&
         ('adminRole' in get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data &&
          get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.adminRole in ['SUPER_ADMIN', 'MODERATOR', 'LIBRARY_ADMIN', 'NOTIFICATION_ADMIN', 'ADMIN', 'Admin', 'admin'])
        ) ||
        (exists(/databases/$(database)/documents/privateUsers/$(request.auth.uid)) &&
         ('adminRole' in get(/databases/$(database)/documents/privateUsers/$(request.auth.uid)).data &&
          get(/databases/$(database)/documents/privateUsers/$(request.auth.uid)).data.adminRole in ['SUPER_ADMIN', 'MODERATOR', 'LIBRARY_ADMIN', 'NOTIFICATION_ADMIN', 'ADMIN', 'Admin', 'admin'])
        )
      );
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.uid == 'Zdxi8kTc2kcs1cOPxWS81PTVmco2' ||
        request.auth.uid == 'DdP2c855PSRUJwhmN9rvbkYBraP2' ||
        (exists(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)) &&
         ('adminRole' in get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data &&
          get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.adminRole == 'SUPER_ADMIN')
        ) ||
        (exists(/databases/$(database)/documents/privateUsers/$(request.auth.uid)) &&
         ('adminRole' in get(/databases/$(database)/documents/privateUsers/$(request.auth.uid)).data &&
          get(/databases/$(database)/documents/privateUsers/$(request.auth.uid)).data.adminRole == 'SUPER_ADMIN')
        )
      );
    }

    function isValidName(name) {
      return name is string &&
             name.size() >= 2 &&
             name.size() <= 40 &&
             name.matches('^(?:[a-zA-Z]+\\.?\\s)?[a-zA-Z]+(\\s[a-zA-Z]+){1,3}$');
    }

    function isSafeContentUpdate() {
      return (resource == null) ? 
             !request.resource.data.keys().hasAny(['adminRole', 'permissions', 'isAdmin', 'isSuperAdmin', 'claims', 'ownerUid', 'authorUid', 'authorEmail', 'ownerEmail', 'createdBy', 'verifiedBy', 'approvedBy', 'status', 'isVerified', 'isApproved']) :
             !request.resource.data.diff(resource.data).affectedKeys().hasAny(['adminRole', 'permissions', 'isAdmin', 'isSuperAdmin', 'claims', 'ownerUid', 'authorUid', 'authorEmail', 'ownerEmail', 'createdBy', 'verifiedBy', 'approvedBy', 'status', 'isVerified', 'isApproved']);
    }

    // -----------------------------
    // PUBLIC PROFILES (New)
    // -----------------------------
    match /publicProfiles/{userId} {
      // Anyone can read public profiles
      allow read: if true;
      // Only owner or admin can create/update their profile, enforcing name validation
      // Or guest users can register their push tokens under guest_* document IDs
      // Prevent privilege escalation: non-admin users cannot write 'adminRole' or 'departmentAdminRoles'
      allow create, update: if (
        (
          isAuthenticated() && 
          (request.auth.uid == userId || isAdmin()) &&
          (!('name' in request.resource.data) || isValidName(request.resource.data.name)) &&
          (isSuperAdmin() || (
            (!('role' in request.resource.data) || request.resource.data.role in ['Student', 'Faculty', 'Alumni', 'Other', 'Guest']) &&
            (resource == null ? 
              !request.resource.data.keys().hasAny(['adminRole', 'permissions', 'isAdmin', 'isSuperAdmin', 'claims', 'departmentAdminRoles', 'verifiedBy', 'approvedBy', 'status', 'isVerified', 'isApproved']) :
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['adminRole', 'permissions', 'isAdmin', 'isSuperAdmin', 'claims', 'departmentAdminRoles', 'verifiedBy', 'approvedBy', 'status', 'isVerified', 'isApproved'])
            )
          ))
        ) || (
          userId.startsWith('guest_') && 
          request.resource.data.role == 'Guest' && 
          request.resource.data.isGuest == true && 
          !('adminRole' in request.resource.data) &&
          !('departmentAdminRoles' in request.resource.data)
        )
      );
      allow delete: if isAdmin();
    }

    // -----------------------------
    // PRIVATE USERS (New - Highly Secure)
    // -----------------------------
    match /privateUsers/{userId} {
      // ONLY the owner or admin can read/write their private account data
      // Prevent privilege escalation: non-admin users cannot write 'adminRole'
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin()) && (
        isSuperAdmin() || (
          (!('role' in request.resource.data) || request.resource.data.role in ['Student', 'Faculty', 'Alumni', 'Other', 'Guest']) &&
          (resource == null ? 
            !request.resource.data.keys().hasAny(['adminRole', 'permissions', 'isAdmin', 'isSuperAdmin', 'claims', 'departmentAdminRoles', 'verifiedBy', 'approvedBy', 'status', 'isVerified', 'isApproved']) :
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['adminRole', 'permissions', 'isAdmin', 'isSuperAdmin', 'claims', 'departmentAdminRoles', 'verifiedBy', 'approvedBy', 'status', 'isVerified', 'isApproved'])
          )
        )
      );
    }

    // -----------------------------
    // LEGACY USERS COLLECTION
    // -----------------------------
    match /users/{userId} {
      // Top-level users collection is completely locked down.
      // Do not allow access to top-level user documents anymore.
      allow read, write: if false;

      // -----------------------------
      // PRIVATE NOTIFICATIONS (Subcollection)
      // -----------------------------
      match /notifications/{notificationId} {
        allow read: if isAuthenticated() && request.auth.uid == userId;
        allow update: if isAuthenticated() && request.auth.uid == userId && 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'read', 'readAt']);
        allow delete: if isAuthenticated() && (
          request.auth.uid == userId ||
          (resource != null && 'senderUid' in resource.data && resource.data.senderUid == request.auth.uid)
        );
        allow create: if isAuthenticated() && (
          request.auth.uid == userId ||
          isAdmin() ||
          request.resource.data.type in ['connection_request', 'connection_accepted', 'system', 'comment', 'welcome', 'event', 'post_policy_violation']
        );
      }

      // -----------------------------
      // USER CONNECTIONS (Subcollection)
      // -----------------------------
      match /connections/{connectionId} {
        allow read: if isAuthenticated() && request.auth.uid == userId;
        allow write: if isAuthenticated() && (request.auth.uid == userId || request.auth.uid == connectionId);
      }
    }

    // -----------------------------
    // EMAIL LOOKUP COLLECTION (New - Fully Hardened)
    // -----------------------------
    match /emailLookup/{identifier} {
      // Direct client-side reads are completely blocked except for admins.
      // All lookups now occur via secure HTTPS Callable Cloud Functions.
      allow read: if isAdmin();
      
      // Strict Validation: Allow write if authenticated
      allow write: if isAuthenticated();
    }

    // -----------------------------
    // USERNAMES COLLECTION
    // -----------------------------
    match /usernames/{username} {
      // Anyone can check usernames availability during signup
      allow read: if true;

      // Username can be created only once by its owner
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;

      // Allow owner or admin to release username on updates
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      
      allow update: if false;
    }

    // -----------------------------
    // POSTS COLLECTION (Feed Posts & Polls)
    // -----------------------------
    match /posts/{postId} {
      // Anyone can read feed posts
      allow read: if true;

      // Logged in users can create posts with their own authorUid
      allow create: if isAuthenticated() && request.resource.data.authorUid == request.auth.uid;

      // Post authors can update anything, or peers can only toggle their own reactions, or admins can update anything
      allow update: if isAuthenticated() && (
        isAdmin() ||
        // Case A: Post author can update (prevent authorUid spoofing)
        ('authorUid' in resource.data && resource.data.authorUid == request.auth.uid && isSafeContentUpdate()) ||
        // Case B: Peer reaction update
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claps', 'heartedBy']) &&
         request.resource.data.claps == request.resource.data.heartedBy.size() &&
         (
           (request.resource.data.heartedBy.removeAll(resource.data.heartedBy).hasOnly([request.auth.uid])) ||
           (resource.data.heartedBy.removeAll(request.resource.data.heartedBy).hasOnly([request.auth.uid]))
         )
        ) ||
        // Case C: Peer poll vote update
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pollOptions', 'totalVotes', 'userVotedOptionId', 'updatedAt', 'lastInteraction'])) ||
        // Case D: Peer comment/commentsCount update for legacy sync compatibility
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments', 'commentsCount']))
      );

      // Only the post author or admin can delete their post
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        ('authorUid' in resource.data && resource.data.authorUid == request.auth.uid)
      );

      // -----------------------------
      // SECURE COMMENTS SUBCOLLECTION (Phase 3 Hardened)
      // -----------------------------
      match /comments/{commentId} {
        allow read: if true;
        // Only authenticated users can write comments, and they must own the userId mapping
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        
        allow update: if isAuthenticated() && (
          isAdmin() ||
          (resource.data.userId == request.auth.uid && (!('userId' in request.resource.data) || request.resource.data.userId == resource.data.userId)) ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) &&
            (
              request.resource.data.likes.removeAll(resource.data.likes).hasOnly([request.auth.uid]) ||
              resource.data.likes.removeAll(request.resource.data.likes).hasOnly([request.auth.uid])
            )
          ) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replies'])
        );
        
        allow delete: if isAuthenticated() && (
          isAdmin() ||
          resource.data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/posts/$(postId)).data.authorUid == request.auth.uid
        );
      }

      // -----------------------------
      // SECURE HEARTS SUBCOLLECTION (Phase 3 Hardened)
      // -----------------------------
      match /hearts/{userId} {
        allow read: if true;
        // Users can only write/delete their own heart document mapping
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // -----------------------------
    // COLLECTION GROUP: comments (For Admin deletion)
    // -----------------------------
    match /{path=**}/comments/{commentId} {
      allow read, delete: if isAdmin();
    }

    // -----------------------------
    // DEFAULT DENY
    // -----------------------------
    
    // -----------------------------
    // SAVED POSTS COLLECTION (New)
    // -----------------------------
    match /savedPosts/{userId}/posts/{postId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // -----------------------------
    // REPORTED COMMENTS COLLECTION (New)
    // -----------------------------
    match /reportedComments/{reportId} {
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }
    
    // -----------------------------
    // REPORTS COLLECTION
    // -----------------------------
    match /reports/{reportId} {
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // -----------------------------
    // DELETION REQUESTS COLLECTION
    // -----------------------------
    match /deletion_requests/{requestId} {
      allow create, read: if isAuthenticated() && request.auth.uid == requestId;
      allow read, update, delete: if isAdmin();
    }

    // -----------------------------
    // EVENTS COLLECTION
    // -----------------------------
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorUid == request.auth.uid;
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (resource.data.authorUid == request.auth.uid && isSafeContentUpdate())
      );
      allow delete: if isAuthenticated() && (resource.data.authorUid == request.auth.uid || isAdmin());
    }

    // -----------------------------
    // GIGS & OPPORTUNITIES COLLECTION
    // -----------------------------
    match /gigs/{gigId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorUid == request.auth.uid;
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (resource.data.authorUid == request.auth.uid && isSafeContentUpdate())
      );
      allow delete: if isAuthenticated() && (resource.data.authorUid == request.auth.uid || isAdmin());
      
      // Private applications subcollection
      match /applications/{appId} {
        // Applicant can read their own, Author can read all, Admin can read all
        allow read: if isAuthenticated() && (
          resource.data.applicantUid == request.auth.uid || 
          get(/databases/$(database)/documents/gigs/$(gigId)).data.authorUid == request.auth.uid || 
          isAdmin()
        );
        allow create: if isAuthenticated() && request.resource.data.applicantUid == request.auth.uid;
        allow update: if isAuthenticated() && (
          isAdmin() ||
          (resource.data.applicantUid == request.auth.uid && (!('applicantUid' in request.resource.data) || request.resource.data.applicantUid == resource.data.applicantUid)) ||
          (get(/databases/$(database)/documents/gigs/$(gigId)).data.authorUid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerReply']))
        );
        allow delete: if isAuthenticated() && (resource.data.applicantUid == request.auth.uid || isAdmin());
      }
    }

    // -----------------------------
    // ADMIN LOGS COLLECTION
    // -----------------------------
    match /admin_logs/{logId} {
      allow create: if isAdmin();
      allow read: if isAdmin();
    }
    
    // -----------------------------
    // POLL VOTES COLLECTION (New)
    // -----------------------------
    match /pollVotes/{voteId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // -----------------------------
    // STUDY MATERIALS (New)
    // -----------------------------
    match /study_material_submissions/{submissionId} {
      // Anyone can read approved materials; unapproved materials require ownership or admin rights
      allow read: if (resource.data.status == 'APPROVED') || (isAuthenticated() && (resource.data.ownerUid == request.auth.uid || isAdmin()));
      // Users can create pending submissions
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      // Owners can edit safe fields, admins can update anything (including status)
      allow update: if isAdmin() || (
        isAuthenticated() && resource.data.ownerUid == request.auth.uid && isSafeContentUpdate()
      );
      // Admins or the original owner can delete
      allow delete: if isAuthenticated() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    match /study_material_reports/{reportId} {
      allow create: if isAuthenticated() && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // -----------------------------
    // COMMUNITIES (Chat Rooms)
    // -----------------------------
    match /communities/{communityId}/messages/{messageId} {
      allow read: if isAuthenticated();
      // Allow create if authenticated and user id matches senderUid
      allow create: if isAuthenticated() && request.resource.data.senderUid == request.auth.uid;
      // Allow update if admin or owner
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (resource.data.senderUid == request.auth.uid && (!('senderUid' in request.resource.data) || request.resource.data.senderUid == resource.data.senderUid))
      );
      // Allow delete if admin or owner
      allow delete: if isAuthenticated() && (isAdmin() || resource.data.senderUid == request.auth.uid);
    }

    // -----------------------------
    // DEPT NOTICE BOARD (New)
    // -----------------------------
    match /deptNoticeBoard/{deptId}/posts/{postId} {
      allow read: if isAuthenticated();
      // Allow create, update, delete if the user is a super admin or faculty admin for this dept
      allow create, update, delete: if isAuthenticated() && (
        isAdmin() ||
        (
          exists(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)) &&
          'deptFacultyAdminRoles' in get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data &&
          deptId in get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.deptFacultyAdminRoles
        )
      );
    }

    // -----------------------------
    // CAMPUS OLX COLLECTION
    // -----------------------------
    match /campusOlx/{itemId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorUid == request.auth.uid;
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (resource.data.authorUid == request.auth.uid && isSafeContentUpdate())
      );
      allow delete: if isAuthenticated() && (resource.data.authorUid == request.auth.uid || isAdmin());
      
      // Comments subcollection
      match /comments/{commentId} {
        // Anyone can read comments
        allow read: if isAuthenticated();
        // Commenter can create
        allow create: if isAuthenticated() && request.resource.data.applicantUid == request.auth.uid;
        // Commenter or Admin can update/delete
        allow update: if isAuthenticated() && (
          isAdmin() ||
          (resource.data.applicantUid == request.auth.uid && (!('applicantUid' in request.resource.data) || request.resource.data.applicantUid == resource.data.applicantUid))
        );
        allow delete: if isAuthenticated() && (resource.data.applicantUid == request.auth.uid || isAdmin());
      }
    }

    // -----------------------------
    // GLOBALS COLLECTION
    // -----------------------------
    match /globals/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
